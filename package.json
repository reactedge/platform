{
  "name": "@reactedge/platform",
  "private": true,
  "type": "module",
  "scripts": {
    "configure:ui": "node --experimental-strip-types launcher/control-panel/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b && npm run typecheck --workspace @reactedge/mcp",
    "test:mcp": "npm run test --workspace @reactedge/mcp",
    "verify": "npm run lint && npm run typecheck && npm run build --workspaces",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "tsx": "^4.23.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@react-google-maps/api": "^2.20.8",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1",
    "rollup-plugin-visualizer": "^7.0.1"
  },
  "workspaces": [
    "mcp",
    "services/orchestrator",
    "packages/*",
    "widgets/*",
    "tests/*"
  ]
}
