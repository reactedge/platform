PORT=4190
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
OTEL_HOST=http://localhost:4318
OTEL_SERVICE_NAME=reactedge-cmsblock
# CMSBLOCK_DATA_DIR=/absolute/path/to/data

# Default remains deterministic, so existing demos need no AI credentials.
CMSBLOCK_GENERATOR=deterministic
# For AI generation: set CMSBLOCK_GENERATOR=openai and supply a server-side API key.
# OPENAI_API_KEY=
CMSBLOCK_AI_MODEL=gpt-4.1-mini
CMSBLOCK_PROMPT_VERSION=v1
# Optional exact CDN URL for the versioned prompt JSON. Keep its "version" field aligned.
# CMSBLOCK_PROMPT_URL=https://cdn.example.com/cmsblock/prompt.v1.json
